# Hive UI — environment variables
# Copy to .env and fill in your values before running docker compose up

# ── LLM ──────────────────────────────────────────────────────────────────────
# OpenRouter API key (get one free at https://openrouter.ai/)
OPENROUTER_API_KEY=sk-or-v1-...

# Model to use (default: deepseek/deepseek-r1:free — OpenRouter free tier)
# Other good free options:
#   qwen/qwen3-coder:free
#   nousresearch/hermes-3-llama-3.1-405b:free
#   meta-llama/llama-3.3-70b-instruct:free
# Local Ollama (if running on host):
#   set LLM_BASE_URL=http://host.docker.internal:11434/v1 and OPENROUTER_MODEL=hermes3:8b
OPENROUTER_MODEL=deepseek/deepseek-r1:free

# Override base URL to use any OpenAI-compatible API
LLM_BASE_URL=https://openrouter.ai/api/v1

# ── GitHub task tracking ──────────────────────────────────────────────────────
# Repo where one PR per prompt will be created (created automatically if absent)
GITHUB_TASKS_REPO=iubayb/hive-tasks

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8888
