# ── hive-ui defaults ──────────────────────────────────────────────────────────
# Lowest-priority fallback for both local (logstream.py) and Vercel.
# Override locally via ~/.config/hive-ui/env or ~/.config/research-hive/env.
# Override on Vercel via dashboard env vars (OPENROUTER_MODEL / OPENROUTER_API_KEY).

# Most capable free model on OpenRouter — used by Vercel standalone deployment.
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Hive GitHub repo — required for TS34 and org_guard.py (set 2026-05-04)
HIVE_GITHUB_REPO=iubayb/hive-ui
