# Hive backend Python server URL (required for SSE proxy + API calls)
HIVE_BACKEND_URL=http://localhost:8888

# GitHub API token (optional, increases rate limits)
GITHUB_TOKEN=

# GitHub repo for hive-ui content
GITHUB_OWNER=iubayb
GITHUB_REPO=hive-ui

# OpenRouter API key for AI assistant
OPENROUTER_API_KEY=

# OpenRouter model (default: meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# AES-256-GCM key for key vault (64 hex chars, leave empty for dev)
VAULT_ENCRYPTION_KEY=

# Revalidation secret for ISR (optional)
REVALIDATE_SECRET=
